# Rust
/target/
**/*.rs.bk
*.pdb

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Local fixtures and scratch data
/fixtures/local/
/tmp/
*.local.json

# Price books are fetched at runtime into the user data dir, never shipped.
/crates/tokenstat-core/pricing/

# Internal working notes. Research, design rationale, and session handover.
# The whole docs/ directory, with no exceptions. A `!` un-ignore is how two
# files leaked onto GitHub. Do not add one. tools/ is unused local scratch.
/roadmap.md
/WORKLOG.md
/CLAUDE.md
/TODO.md
/docs/
/tools/

# Coverage and profiling
/coverage/
lcov.info
*.profraw
*.profdata
flamegraph.svg
perf.data*

# Editors and tooling
.vscode/
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.iml
.zed/
.direnv/
.cursor/

# OS
.DS_Store
.AppleDouble
Thumbs.db
desktop.ini

# Build and release scratch
/release-artifacts/
/pkg/
/dist/

# Apple app. Everything here is generated, and committing any of it means
# resolving pbxproj conflicts by hand forever. `apps/mac/project.yml` is the
# source of truth, and the xcframework comes from
# `scripts/build-ffi-xcframework.sh`.
/apps/mac/Tokenstat.xcodeproj/
/apps/mac/Vendor/
/apps/mac/Resources/THIRD_PARTY_NOTICES.md
# The price book an app bundle ships with. Downloaded at build time by
# `cargo xtask pricing-seed`, and it goes stale, so it is generated and never
# committed. Same rule as the notices above. The `.etag` beside it is the
# conditional-request bookkeeping the downloader writes.
/apps/mac/Resources/PriceBookSeed.json
/apps/mac/Resources/PriceBookSeed.etag
# Every app's build output, whatever the tool put it there. Xcode writes
# `build/` next to the project when a scheme is built from the command line,
# and local sessions often pass `-derivedDataPath DerivedData<Name>`, so the
# folder is not always literally `DerivedData/`. Hundreds of megabytes either
# way. Never committed.
/apps/*/build/
/apps/*/DerivedData*/
/apps/windows/bin/
/apps/windows/obj/
/apps/windows/.vs/
/apps/windows/*.user
/apps/windows/*.suo
# Gradle puts each module's build output inside the module, so the Android
# app's is one level deeper than the Xcode one above.
/apps/android/**/build/
xcuserdata/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# Android app. Credentials and local SDK selection never enter the repository.
/apps/android/.gradle/
/apps/android/app/google-services.json
/apps/android/local.properties
# Play upload keystore. The real file lives in ~/.tokenstat/android/.
*.jks
*.keystore

<Application
    x:Class="NativeUiTests.SmokeApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Match production Page content layout, including the outer
                 workspace page which holds a TabView rather than a Grid. -->
            <Style TargetType="Page">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
            <!-- Use the production toolbar field metrics for layout checks. -->
            <Style TargetType="TextBox">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style TargetType="NavigationViewItem">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <!-- The native header uses a TextBlock bound to Content. Our
                 project heading includes a count and a keyboard reachable button. -->
            <Style TargetType="NavigationViewItemHeader">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="NavigationViewItemHeader">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                Margin="16,12,8,4" MinHeight="28" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>../../../apps/windows/app.manifest</ApplicationManifest>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>NativeUiTests</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <AppxPackage>false</AppxPackage>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <SelfContained>true</SelfContained>
    <Platform>x64</Platform><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <Compile Include="../../../apps/windows/Pages/WorkspaceTabStrip.cs" Link="WorkspaceTabStrip.cs" />
    <Compile Include="../../../apps/windows/Pages/EditorTree.cs" Link="EditorTree.cs" />
    <Compile Include="../../../apps/windows/Pages/EditorText.cs" Link="EditorText.cs" />
    <Compile Include="../../../apps/windows/Pages/H264Streamer.cs" Link="H264Streamer.cs" />
    <Compile Include="../../../apps/windows/Pages/ScreenFrame.cs" Link="ScreenFrame.cs" />
    <Compile Include="../../../apps/windows/Navigation/NavigationRows.cs" Link="NavigationRows.cs" />
    <Compile Include="../../../apps/windows/Navigation/NavigationExpansion.cs" Link="NavigationExpansion.cs" />
    <Compile Include="../../../apps/windows/Pages/TerminalSurface.cs" Link="TerminalSurface.cs" />
    <Compile Include="../../../apps/windows/Pages/TerminalPalette.cs" Link="TerminalPalette.cs" />
    <Compile Include="../../../apps/windows/Design/NativeContentLayout.cs" Link="NativeContentLayout.cs" />
    <Compile Include="../../../apps/windows/Design/InspectorHost.cs" Link="InspectorHost.cs" />
    <Compile Include="../../../apps/windows/Design/FlowPanel.cs" Link="FlowPanel.cs" />
    <Compile Include="../../../apps/windows/Design/Theme.cs" Link="Theme.cs" />
    <Content Include="../../../apps/windows/Assets/Terminal/*" Link="Assets/Terminal/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../apps/windows/Assets/Fonts/JetBrainsMono-Variable.ttf" Link="Assets/Fonts/JetBrainsMono-Variable.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

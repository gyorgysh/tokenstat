<Project>
  <!-- SPDX-License-Identifier: LicenseRef-tokenstat-source-available -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../../apps/windows/Design/L10n.cs" Link="L10n.cs" />
    <Content Include="$(MSBuildThisFileDirectory)../../apps/localization/**/common.json;$(MSBuildThisFileDirectory)../../apps/localization/**/windows.json">
      <Link>localization/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>

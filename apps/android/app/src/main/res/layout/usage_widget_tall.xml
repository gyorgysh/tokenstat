<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="36dp" android:layout_alignParentTop="true" android:gravity="center_vertical" android:baselineAligned="false">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_notification" android:tint="@color/ts_widget_accent" android:contentDescription="@null" />
        <TextView android:id="@+id/widget_brand_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/widget_brand" android:textStyle="bold" android:textSize="16sp" android:fontFamily="@font/widget_manrope" android:paddingStart="7dp" android:paddingEnd="0dp" android:textColor="@color/ts_widget_accent" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
        <ImageButton android:id="@+id/widget_refresh" android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:src="@drawable/widget_refresh" android:background="@android:color/transparent" android:contentDescription="@string/widget_refresh" />
    </LinearLayout>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:text="@string/widget_open_to_sync" android:fontFamily="@font/widget_manrope" android:textSize="11sp" android:textColor="@color/ts_widget_muted" android:maxLines="1" android:ellipsize="end" android:paddingTop="5dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/widget_header" android:layout_above="@id/widget_status" android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widget_period" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="24dp" android:gravity="center_vertical" android:paddingHorizontal="7dp" android:background="@drawable/widget_period" android:text="@string/widget_today" android:fontFamily="@font/widget_manrope" android:textStyle="bold" android:textSize="11sp" android:textColor="@color/ts_widget_accent" android:contentDescription="@string/widget_period_hint" android:maxLines="1" />
            <TextView android:id="@+id/widget_value" android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:text="@string/widget_unknown" android:fontFamily="@font/widget_manrope" android:textStyle="bold" android:textSize="30sp" android:textColor="@color/ts_widget_text" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="15sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp" android:maxLines="1" />
            <TextView android:id="@+id/widget_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_list_rates" android:fontFamily="@font/widget_manrope" android:textSize="11sp" android:textColor="@color/ts_widget_muted" android:maxLines="2" />
        </LinearLayout>
        <RelativeLayout android:id="@+id/widget_chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="16dp" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:layout_toStartOf="@id/widget_week_total" android:text="@string/widget_week_short" android:textSize="11sp" android:textColor="@color/ts_widget_muted" android:maxLines="1" android:fontFamily="@font/widget_manrope" />
            <TextView android:id="@+id/widget_week_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="@string/widget_unknown" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/ts_widget_text" android:maxLines="1" android:fontFamily="@font/widget_manrope" />
            <ImageView android:id="@+id/widget_bars" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/widget_week_total" android:scaleType="fitXY" android:layout_marginTop="8dp" android:contentDescription="@null" />
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>

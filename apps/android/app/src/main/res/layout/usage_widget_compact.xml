<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="6dp" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="24dp" android:layout_alignParentTop="true" android:gravity="center_vertical" android:baselineAligned="false">
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_notification" android:tint="@color/ts_widget_accent" android:contentDescription="@null" />
        <TextView android:id="@+id/widget_brand_label" android:visibility="gone" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/widget_brand" android:textStyle="bold" android:textSize="12sp" android:fontFamily="@font/widget_manrope" android:paddingStart="7dp" android:paddingEnd="0dp" android:textColor="@color/ts_widget_accent" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/widget_period" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="24dp" android:gravity="center_vertical" android:paddingHorizontal="3dp" android:background="@drawable/widget_period" android:text="@string/widget_today" android:fontFamily="@font/widget_manrope" android:textStyle="bold" android:textSize="11sp" android:textColor="@color/ts_widget_accent" android:contentDescription="@string/widget_period_hint" android:maxLines="1" android:maxWidth="60dp" />
            <ImageButton android:id="@+id/widget_refresh" android:layout_width="24dp" android:layout_height="24dp" android:padding="4dp" android:src="@drawable/widget_refresh" android:background="@android:color/transparent" android:contentDescription="@string/widget_refresh" />
    </LinearLayout>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:text="@string/widget_open_to_sync" android:fontFamily="@font/widget_manrope" android:textSize="11sp" android:textColor="@color/ts_widget_muted" android:maxLines="1" android:ellipsize="end" android:paddingTop="5dp" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/widget_header" android:layout_above="@id/widget_status" android:gravity="center_vertical" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widget_value" android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical" android:text="@string/widget_unknown" android:fontFamily="@font/widget_manrope" android:textStyle="bold" android:textSize="30sp" android:textColor="@color/ts_widget_text" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="26sp" android:autoSizeStepGranularity="1sp" android:maxLines="1" />
            <TextView android:id="@+id/widget_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_list_rates" android:fontFamily="@font/widget_manrope" android:textSize="11sp" android:textColor="@color/ts_widget_muted" android:maxLines="2" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_chart" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="0dp" android:visibility="gone">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:layout_toStartOf="@id/widget_week_total" android:text="@string/widget_week_short" android:textSize="11sp" android:textColor="@color/ts_widget_muted" android:maxLines="1" android:fontFamily="@font/widget_manrope" />
                <TextView android:id="@+id/widget_week_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="@string/widget_unknown" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/ts_widget_text" android:maxLines="1" android:fontFamily="@font/widget_manrope" />
            </RelativeLayout>
            <ImageView android:id="@+id/widget_bars" android:layout_width="match_parent" android:layout_height="56dp" android:scaleType="fitXY" android:layout_marginTop="8dp" android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
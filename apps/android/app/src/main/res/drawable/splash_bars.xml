<?xml version="1.0" encoding="utf-8"?>
<!-- Splash glyph: the three bars on transparency, one group each so the
     launch animation rises them in turn. The canvas is the 288dp splash
     viewport and the bars are the middle 44dp, the exact geometry of the
     `LogoMark(size = 44)` the LoadingScreen holds centered behind the
     splash. Same size, same place, so the handoff is seamless instead of
     a shrink. The splash background comes from the launch theme. -->

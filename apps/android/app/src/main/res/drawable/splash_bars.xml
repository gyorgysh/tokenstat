    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedResources"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">
    <group
        android:name="barShort"
        android:pivotX="128.29"
        android:pivotY="166">
        <path
            android:fillColor="#C3B0FF"
            android:pathData="M125.67,147.14 h5.23 a3.67,3.67 0 0 1 3.67,3.67 v11.52 a3.67,3.67 0 0 1 -3.67,3.67 h-5.23 a3.67,3.67 0 0 1 -3.67,-3.67 v-11.52 a3.67,3.67 0 0 1 3.67,-3.67 z" />
    </group>
    <group
        android:name="barMid"
        android:pivotX="144"
        android:pivotY="166">
        <path
            android:fillColor="#8B5CF6"
            android:pathData="M141.38,134.57 h5.23 a3.67,3.67 0 0 1 3.67,3.67 v24.09 a3.67,3.67 0 0 1 -3.67,3.67 h-5.23 a3.67,3.67 0 0 1 -3.67,-3.67 v-24.09 a3.67,3.67 0 0 1 3.67,-3.67 z" />
    </group>
    <group
        android:name="barTall"
        android:pivotX="159.71"
        android:pivotY="166">
        <path
            android:fillColor="#E879F9"
            android:pathData="M157.10,122 h5.23 a3.67,3.67 0 0 1 3.67,3.67 v36.66 a3.67,3.67 0 0 1 -3.67,3.67 h-5.23 a3.67,3.67 0 0 1 -3.67,-3.67 v-36.66 a3.67,3.67 0 0 1 3.67,-3.67 z" />

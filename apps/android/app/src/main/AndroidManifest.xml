<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The offline state. Android already runs its own captive-portal check
         and publishes the verdict as a network capability, so the app reads
         that answer instead of probing an endpoint of its own. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:name=".TokenstatApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="tokenstat"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Tokenstat">
        <service android:name=".ecosystem.TokenstatAppFunctionService" tools:targetApi="36"
            android:enabled="@bool/app_functions_enabled" android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE">
            <property android:name="android.app.appfunctions.schema" android:value="app_functions_schema.xsd" />
            <property android:name="android.app.appfunctions.v2" android:value="tokenstat_functions.xml" />
            <intent-filter><action android:name="android.app.appfunctions.AppFunctionService" /></intent-filter>
        </service>
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Tokenstat.Launch"
            android:exported="true">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/uri-list" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tokenstat" android:host="project" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="tokenstat.ai" android:pathPrefix="/app/auth" />
            </intent-filter>
            <!-- The sign-in callback, the same scheme the site redirects the
                 iOS authentication session to. A custom scheme needs no
                 verified link, so it also works on debug builds. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tokenstat" android:host="auth" android:pathPrefix="/done" />
            </intent-filter>
        </activity>
        <service
            android:name=".notifications.TokenstatMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <receiver android:name=".ecosystem.UsageWidgetProvider" android:exported="false" android:label="@string/widget_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/usage_widget" />
        </receiver>
        <activity android:name=".ecosystem.UsageWidgetConfigurationActivity" android:exported="true" android:theme="@style/Theme.Tokenstat">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <activity android:name=".ecosystem.LimitsWidgetConfigurationActivity" android:exported="true" android:theme="@style/Theme.Tokenstat">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <receiver android:name=".ecosystem.LimitsWidgetProvider" android:exported="false" android:label="@string/widget_limits_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/limits_widget" />
        </receiver>
        <receiver android:name=".ecosystem.LauncherWidgetProvider" android:exported="false" android:label="@string/widget_launcher_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/launcher_widget" />
        </receiver>
        <service android:name=".ecosystem.WorkspacesTileService" android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:icon="@drawable/ic_tile_workspaces" android:label="@string/shortcut_workspaces">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
    </application>
</manifest>

#!/bin/sh
# SPDX-License-Identifier: LicenseRef-tokenstat-source-available
set -eu

VERSION=9.8.1
SHA256=dce76f55f8e251a3a1f130eb120f30b3d271de2b76c9b0729d316b5a1b6dc01f
DIST="${GRADLE_USER_HOME:-$HOME/.gradle}/tokenstat/gradle-$VERSION"
if [ ! -x "$DIST/bin/gradle" ]; then
  ARCHIVE="$DIST-bin.zip"
  mkdir -p "$(dirname "$DIST")"
  curl -fL "https://services.gradle.org/distributions/gradle-$VERSION-bin.zip" -o "$ARCHIVE"
  if command -v sha256sum >/dev/null 2>&1; then
    ACTUAL=$(sha256sum "$ARCHIVE" | cut -d ' ' -f 1)
  else
    ACTUAL=$(shasum -a 256 "$ARCHIVE" | cut -d ' ' -f 1)
  fi
  if [ "$ACTUAL" != "$SHA256" ]; then
    rm -f "$ARCHIVE"
    echo "error: Gradle distribution checksum mismatch" >&2
    exit 1
  fi
  unzip -q "$ARCHIVE" -d "$(dirname "$DIST")"
  rm -f "$ARCHIVE"
fi
exec "$DIST/bin/gradle" "$@"

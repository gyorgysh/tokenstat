<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TestFlight and the App Store are production. An archive carrying
	     `development` here registers against the sandbox host and every push
	     to it is refused. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>

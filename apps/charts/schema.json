{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tokenstat chart v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "type",
    "title",
    "series"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "bar",
        "line",
        "area",
        "pie",
        "donut",
        "scatter",
        "bubble",
        "heatmap",
        "radar",
        "funnel",
        "treemap",
        "boxplot"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 180,
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "source": {
      "type": "string",
      "maxLength": 500
    },
    "categories": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 160,
        "minLength": 1
      }
    },
    "yCategories": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 160,
        "minLength": 1
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "data"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1
          },
          "data": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": -1000000000000000.0,
                  "maximum": 1000000000000000.0
                },
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 5,
                  "items": {
                    "type": "number",
                    "minimum": -1000000000000000.0,
                    "maximum": 1000000000000000.0
                  }
                }
              ]
            }
          }
        }
      }
    },
    "xAxis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 120
        },
        "format": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prefix": {
              "type": "string",
              "maxLength": 24
            },
            "suffix": {
              "type": "string",
              "maxLength": 24
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            }
          }
        }
      }
    },
    "yAxis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 120
        },
        "format": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prefix": {
              "type": "string",
              "maxLength": 24
            },
            "suffix": {
              "type": "string",
              "maxLength": 24
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            }
          }
        }
      }
    },
    "stacked": {
      "type": "boolean"
    },
    "horizontal": {
      "type": "boolean"
    },
    "showLabels": {
      "type": "boolean"
    }
  },
  "description": "Version 1, data only. At most 256 KiB and 10000 total points. Categorical series match categories. Scatter [x,y]; bubble [x,y,positive size]; heatmap [xIndex,yIndex,value] with categories and yCategories; boxplot [min,Q1,median,Q3,max]. Pie, donut, funnel, treemap and heatmap require exactly one series. Pie, donut, funnel, treemap and radar require nonnegative values; null is allowed only in bar, line and area. Radar requires 3..12 categories. Stacked is for bar/line/area, horizontal is for bar. Validation tools enforce these cross-field rules."
}
